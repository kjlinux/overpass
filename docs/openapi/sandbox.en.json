{
  "openapi": "3.1.0",
  "info": {
    "title": "Overpass simulator API",
    "version": "1",
    "description": "Providers simulated from their public documentation, with no link to the real providers: every provider is unofficial. Authenticate with an Overpass test key where the provider expects its credential. The Overpass-Scenario header picks the scenario of one call.",
    "x-providers": [
      {
        "id": "wave",
        "name": "Wave",
        "unofficial": true,
        "docsUrl": "https://docs.wave.com/checkout",
        "docsVersion": "2024-03-29",
        "consultedAt": "2026-10-14"
      }
    ]
  },
  "paths": {
    "/v1/sandbox/wave/v1/checkout/sessions": {
      "post": {
        "summary": "Create a checkout session",
        "tags": [
          "Wave"
        ],
        "security": [
          {
            "wave": []
          }
        ],
        "parameters": [
          {
            "name": "Overpass-Scenario",
            "in": "header",
            "required": false,
            "description": "Scenario of this call, instead of the key's",
            "schema": {
              "type": "string",
              "enum": [
                "success",
                "insufficient_funds",
                "timeout",
                "duplicate_webhook",
                "late_webhook"
              ]
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "amount": {
                    "type": "string",
                    "pattern": "^(0|[1-9]\\d*)(\\.\\d{1,2})?$"
                  },
                  "currency": {
                    "type": "string",
                    "pattern": "^[A-Z]{3}$"
                  },
                  "error_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "success_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "client_reference": {
                    "type": "string",
                    "maxLength": 255
                  },
                  "restrict_payer_mobile": {
                    "type": "string",
                    "pattern": "^\\+\\d{6,15}$"
                  },
                  "enforce_payer_mobile": {
                    "type": "string",
                    "pattern": "^\\+\\d{6,15}$"
                  },
                  "aggregated_merchant_id": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "amount",
                  "currency",
                  "error_url",
                  "success_url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "amount": {
                      "type": "string"
                    },
                    "checkout_status": {
                      "type": "string",
                      "enum": [
                        "open",
                        "complete",
                        "expired"
                      ]
                    },
                    "client_reference": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "currency": {
                      "type": "string"
                    },
                    "error_url": {
                      "type": "string"
                    },
                    "last_payment_error": {
                      "anyOf": [
                        {
                          "type": "object",
                          "properties": {
                            "code": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "code",
                            "message"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "business_name": {
                      "type": "string"
                    },
                    "payment_status": {
                      "type": "string",
                      "enum": [
                        "processing",
                        "cancelled",
                        "succeeded"
                      ]
                    },
                    "transaction_id": {
                      "type": "string"
                    },
                    "aggregated_merchant_id": {
                      "type": "string"
                    },
                    "restrict_payer_mobile": {
                      "type": "string"
                    },
                    "enforce_payer_mobile": {
                      "type": "string"
                    },
                    "success_url": {
                      "type": "string"
                    },
                    "wave_launch_url": {
                      "type": "string"
                    },
                    "when_completed": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "when_created": {
                      "type": "string"
                    },
                    "when_expires": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "amount",
                    "checkout_status",
                    "client_reference",
                    "currency",
                    "error_url",
                    "last_payment_error",
                    "business_name",
                    "payment_status",
                    "transaction_id",
                    "success_url",
                    "wave_launch_url",
                    "when_completed",
                    "when_created",
                    "when_expires"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
