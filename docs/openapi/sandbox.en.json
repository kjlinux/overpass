    "/v1/sandbox/listen": {
      "get": {
        "summary": "Receive your key's webhooks on your machine (local relay, SSE stream)",
        "description": "Opens an outgoing connection that carries each webhook with its raw body and headers. After a disconnection, send Last-Event-ID to receive the webhooks you missed.",
        "tags": [
          "Overpass"
        ],
        "security": [
          {
            "overpass": []
          }
        ],
        "parameters": [
          {
            "name": "Last-Event-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Opens an outgoing connection that carries each webhook with its raw body and headers. After a disconnection, send Last-Event-ID to receive the webhooks you missed.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "provider": {
                          "type": "string"
                        },
                        "keyPrefix": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "provider",
                        "keyPrefix"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "deliveryId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        },
