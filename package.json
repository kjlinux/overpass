{
  "name": "overpass",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json && npm run build -w @overpass/web",
    "dev:api": "tsc -b tsconfig.build.json && npm run dev -w @overpass/api",
    "dev:web": "tsc -b tsconfig.build.json && npm run dev -w @overpass/web",
    "dev:mcp": "tsc -b tsconfig.build.json && npm run dev -w @overpass/mcp",
    "dev:worker": "tsc -b tsconfig.build.json && npm run dev:worker -w @overpass/api",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w @overpass/api",
    "db:rollback": "npm run db:rollback -w @overpass/api",
    "typecheck": "tsc -b tsconfig.build.json && npm run typecheck --workspaces --if-present && tsc -p scripts && tsc -p e2e",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "licenses": "node scripts/licenses.ts",
    "check:repo": "node scripts/check-repo.ts",
    "check:budget": "npm run build && node scripts/check-budget.ts",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run check:repo && npm run check:budget",
    "test:e2e": "playwright test",
    "scan:agents": "node scripts/agent-scan.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-plugin-i18next": "^6.1.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "react": "npm:@preact/compat@^18.3.2",
    "react-dom": "npm:@preact/compat@^18.3.2"
  }
}
