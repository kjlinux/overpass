POSTGRES_USER=overpass
POSTGRES_PASSWORD=overpass
POSTGRES_DB=overpass
POSTGRES_PORT=5432
DATABASE_URL=postgres://overpass:overpass@127.0.0.1:5432/overpass
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false
# At least 32 random characters; generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-32-random-characters-or-more
WEB_ORIGIN=http://127.0.0.1:5173
# Leave SMTP_HOST empty in development: reset links are then written to the API logs.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Overpass <no-reply@localhost>
