POSTGRES_USER=overpass
# Required: docker compose refuses to start without it. Choose your own.
POSTGRES_PASSWORD=
POSTGRES_DB=overpass
POSTGRES_PORT=5432
DATABASE_URL=postgres://overpass:<POSTGRES_PASSWORD>@127.0.0.1:5432/overpass
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 behind Caddy), 0 when exposed directly.
TRUST_PROXY=0
# At least 32 random characters; generate one with: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me-to-32-random-characters-or-more
WEB_ORIGIN=http://127.0.0.1:5173
# Only for npm run db:seed -- --admin-email you@example.org: the first admin password, then remove it.
SEED_ADMIN_PASSWORD=
# Leave SMTP_HOST empty in development: reset links are then written to the API logs.
# Empty in production: the API starts but every mail fails (no reset link, no newsletter).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Refuse to send without STARTTLS; set to false only for a local catcher such as Mailpit.
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Overpass <no-reply@localhost>
# Built web app (apps/web/dist): set it to serve itinerary and article pages with share tags.
WEB_DIST_DIR=
